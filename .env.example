# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Service Configuration
DEBUG=false

# AI Generation Settings
MAX_RETRIES=3
TIMEOUT_SECONDS=60
MAX_TOKENS=4000
TEMPERATURE=0.7

# ── MCP Server Configuration ─────────────────────────────────
# Comma-separated list of MCP server names to enable.
# Each server requires transport, URL/command, and optional env vars.
# MCP_SERVERS=googlemaps,xiaohongshu

# Google Maps MCP Server (stdio transport)
# MCP_SERVER_googlemaps_TRANSPORT=stdio
# MCP_SERVER_googlemaps_COMMAND=npx,-y,@modelcontextprotocol/server-google-maps
# MCP_SERVER_googlemaps_ENABLED=true
# MCP_SERVER_googlemaps_DESCRIPTION=Google Maps for directions, places, and geocoding
# MCP_SERVER_googlemaps_ENV_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Xiaohongshu MCP Server (streamable-http transport)
# Uses the pre-built Docker image: xpzouying/xiaohongshu-mcp
# Docker Hub: https://hub.docker.com/r/xpzouying/xiaohongshu-mcp
#
# Local dev (outside Docker): URL = http://localhost:18060/mcp
# Docker Compose (internal):  URL = http://mcp-xiaohongshu:18060/mcp
#
# MCP_SERVER_xiaohongshu_TRANSPORT=streamable-http
# MCP_SERVER_xiaohongshu_URL=http://localhost:18060/mcp
# MCP_SERVER_xiaohongshu_ENABLED=true
# MCP_SERVER_xiaohongshu_DESCRIPTION=Xiaohongshu social media search for travel recommendations and reviews
