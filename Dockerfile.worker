# Worker image for VoyageAI Kafka Worker (Python)
FROM python:3.13-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc librdkafka-dev && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --prefix=/install .

FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    librdkafka1 && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -r voyageai && useradd -r -g voyageai voyageai

COPY --from=builder /install /usr/local
COPY src ./src
COPY scripts ./scripts

# Create data dir for ChromaDB (Tool-RAG) with correct permissions
RUN mkdir -p /app/data/chroma && chown -R voyageai:voyageai /app/data

USER voyageai

# Seed Tool-RAG on startup, then run the Kafka worker
CMD ["sh", "-c", "python scripts/seed_tools.py && python -m voyageai.kafka.run_worker"]
