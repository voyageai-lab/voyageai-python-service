# Dockerfile for VoyageAI MCP Server (Google Maps)
#
# Runs a Model Context Protocol server that exposes Google Maps tools
# via Streamable HTTP transport. The VoyageAI agent worker connects
# to this server to discover and call Google Maps tools.
#
# Build:   docker build -f Dockerfile.mcp -t voyageai-mcp-server .
# Run:     docker run -p 8080:8080 -e GOOGLE_MAPS_API_KEY=... voyageai-mcp-server

# Stage 1: Build
FROM python:3.13-slim AS builder

WORKDIR /app

# Install system deps for confluent-kafka (shared pyproject.toml)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc librdkafka-dev && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --prefix=/install .

# Stage 2: Runtime
FROM python:3.13-slim

WORKDIR /app

# Runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    librdkafka1 wget && \
    rm -rf /var/lib/apt/lists/*

# Non-root user
RUN groupadd -r voyageai && useradd -r -g voyageai voyageai

COPY --from=builder /install /usr/local
COPY src ./src

# Health check — MCP Streamable HTTP server
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:8080/mcp || exit 1

USER voyageai

EXPOSE 8080

# Run the MCP server with Streamable HTTP transport
CMD ["python", "-m", "voyageai.mcp.google_maps_server"]
